{
  "name": "cleanrag",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first local desktop RAG app for non-technical users.",
  "main": "dist-electron/electron/main.js",
  "author": "coreylallojr",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch",
    "dev:electron": "wait-on dist-electron/main.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "backend:local:setup": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-local.ps1",
    "backend:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-backend-local.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "build": {
    "appId": "com.cleanrag.desktop",
    "productName": "CleanRAG",
    "asarUnpack": [
      "backend/**/*",
      "scripts/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "backend/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
